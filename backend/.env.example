# Application
APP_NAME="E-Commerce Intelligence & Decision Support Platform"
APP_ENV=development
API_V1_PREFIX=/api/v1
DEBUG=true

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce_intelligence
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce_intelligence

# Security & Authentication
SECRET_KEY=change-this-to-a-super-secret-hex-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Data Paths
RAW_DATA_PATH=../data/raw
PROCESSED_DATA_PATH=../data/processed
